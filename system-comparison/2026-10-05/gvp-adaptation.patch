+// Common-platform adapter: the physical hull occupied by the estimated robot
+// is known free of environmental obstacles. No truth geometry is consulted.
+void BlockMap::ClearPhysicalHull(const nav_msgs::OdometryConstPtr &odom){
+ Eigen::Quaterniond q(odom->pose.pose.orientation.w,odom->pose.pose.orientation.x,odom->pose.pose.orientation.y,odom->pose.pose.orientation.z);
+ Eigen::Vector3d p(odom->pose.pose.position.x,odom->pose.pose.position.y,odom->pose.pose.position.z);
+ std::vector<Eigen::Vector3d> pts; std::vector<uint8_t> states;
+ for(double x=-.32;x<=.321;x+=.04) for(double y=-.32;y<=.321;y+=.04) for(double z=-.08;z<=.081;z+=.04){
+  Eigen::Vector3d v=p+q.toRotationMatrix()*Eigen::Vector3d(x,y,z);
+  if(InsideMap(v)){pts.push_back(v);states.push_back(2);}
+ }
+ InseartVox(pts,states);
+ newly_register_idx_.insert(newly_register_idx_.end(),pts.begin(),pts.end());
+}
