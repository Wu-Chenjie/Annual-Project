<?xml version="1.0"?>
<sdf version="1.9"><model name="quadrotor">
  <link name="base_link">
    <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.02</izz></inertia></inertial>
    <collision name="hull"><geometry><box><size>0.64 0.64 0.16</size></box></geometry></collision>
    <visual name="body"><geometry><box><size>0.25 0.18 0.10</size></box></geometry><material><diffuse>0.15 0.2 0.3 1</diffuse></material></visual>
    <visual name="arm_x"><geometry><box><size>0.57 0.035 0.025</size></box></geometry><pose>0 0 0 0 0 0.785398</pose><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
    <visual name="arm_y"><geometry><box><size>0.57 0.035 0.025</size></box></geometry><pose>0 0 0 0 0 -0.785398</pose><material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
    <visual name="rotor_0"><pose>-0.2 0.2 0.035 0 0 0</pose><geometry><cylinder><radius>0.11</radius><length>0.012</length></cylinder></geometry><material><diffuse>0.2 0.7 1 1</diffuse></material></visual>
    <visual name="rotor_1"><pose>-0.2 -0.2 0.035 0 0 0</pose><geometry><cylinder><radius>0.11</radius><length>0.012</length></cylinder></geometry><material><diffuse>0.2 0.7 1 1</diffuse></material></visual>
    <visual name="rotor_2"><pose>0.2 -0.2 0.035 0 0 0</pose><geometry><cylinder><radius>0.11</radius><length>0.012</length></cylinder></geometry><material><diffuse>1 0.4 0.2 1</diffuse></material></visual>
    <visual name="rotor_3"><pose>0.2 0.2 0.035 0 0 0</pose><geometry><cylinder><radius>0.11</radius><length>0.012</length></cylinder></geometry><material><diffuse>1 0.4 0.2 1</diffuse></material></visual>
    <sensor name="contact" type="contact"><always_on>true</always_on><update_rate>50</update_rate><topic>CONTACT_TOPIC</topic><contact><collision>hull</collision></contact></sensor>
    <sensor name="imu" type="imu"><always_on>true</always_on><update_rate>100</update_rate><topic>IMU_TOPIC</topic></sensor>
  </link>
  <plugin filename="annual_motor_system" name="annual::MotorSystem"><motor_time_constant>0.025</motor_time_constant></plugin>
</model></sdf>
