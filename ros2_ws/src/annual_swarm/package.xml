<?xml version="1.0"?>
<package format="3">
  <name>annual_swarm</name><version>0.1.0</version>
  <description>Indoor quadrotor formation with ROS 2 and Gazebo rigid-body physics.</description>
  <maintainer email="maintainers@example.com">Annual Project maintainers</maintainer>
  <license>LicenseRef-Unspecified</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>geometry_msgs</depend><depend>nav_msgs</depend>
