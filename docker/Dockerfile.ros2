FROM ros:jazzy-ros-base
SHELL ["/bin/bash", "-c"]
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ros-jazzy-ros-gz ros-jazzy-gz-sim-vendor ros-jazzy-gz-transport-vendor \
    ros-jazzy-gz-plugin-vendor ros-jazzy-actuator-msgs ros-jazzy-tf2-geometry-msgs \
    python3-colcon-common-extensions python3-pytest python3-yaml python3-numpy python3-scipy \
    ros-jazzy-ament-cmake-pytest ros-jazzy-visualization-msgs build-essential cmake \
    && rm -rf /var/lib/apt/lists/*
ENV OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /workspace
COPY . /workspace
RUN source /opt/ros/jazzy/setup.bash && cd ros2_ws && colcon build --event-handlers console_direct+ --cmake-args -DCMAKE_BUILD_TYPE=Release
CMD ["bash", "-c", "source /opt/ros/jazzy/setup.bash && source ros2_ws/install/setup.bash && ros2 launch annual_swarm decentralized_search.launch.py headless:=true visualize:=false"]
